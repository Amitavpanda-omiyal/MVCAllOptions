@page
@using MVCAllOptions.Orders.Localization
@using MVCAllOptions.Orders.Permissions
@using MVCAllOptions.Orders.Web.Pages.Orders
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@model MVCAllOptions.Orders.Web.Pages.Orders.IndexModel
@inject IStringLocalizer<OrdersResource> L
@inject IAuthorizationService AuthorizationService
@section scripts
{
    <abp-script src="/Pages/Orders/Index.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["Orders"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (await AuthorizationService.IsGrantedAsync(OrdersPermissions.Orders.Create))
                {
                    <abp-button id="NewOrderButton"
                                text="@L["NewOrder"].Value"
                                icon="plus"
                                button-type="Primary"/>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="OrdersTable"></abp-table>
    </abp-card-body>
</abp-card>
